# Copy to .env (never commit .env). Used by docker compose.
CASSANDRA_CLUSTER_NAME=mlw-cluster
# Remote only:
CASSANDRA_BIND=127.0.0.1
CASSANDRA_MAX_HEAP_SIZE=2G
CASSANDRA_HEAP_NEWSIZE=512M

# --- Application (REST API and web UI) ---
# Port the application is published on, and the interface it binds to.
APP_PORT=8090
APP_BIND=127.0.0.1
# Bearer token required by the REST API. Required with docker-compose.prod.yml.
API_TOKEN=
# Create the schema (cql/*.cql) at startup. Safe to repeat; default is true for
# local development and false otherwise.
# APPLY_SCHEMA=false

# Cassandra the application connects to. Defaults to the cassandra service.
# For a remote database set the hosts and credentials, and run only the app
# (see README): docker compose -f docker-compose.yml up -d app
# CASSANDRA_HOSTS=cassandra.example.com
# CASSANDRA_PORT=9042
# CASSANDRA_KEYSPACE=mlw
# CASSANDRA_USERNAME=
# CASSANDRA_PASSWORD=
# CASSANDRA_LOCAL_DC=
# CASSANDRA_CONSISTENCY=LOCAL_QUORUM
# CASSANDRA_TLS=true
# CASSANDRA_TLS_SKIP_VERIFY=false
# Needed when the cluster advertises addresses you cannot reach (SSH tunnel, NAT):
# CASSANDRA_DISABLE_INITIAL_HOST_LOOKUP=true
# CASSANDRA_IGNORE_PEER_ADDR=true

# --- Keycloak (identity and access management) ---
# KEYCLOAK_VERSION=26.4.0
# Admin created on the first start. Change the password in the admin console afterwards.
# KEYCLOAK_ADMIN=admin
# KEYCLOAK_ADMIN_PASSWORD=admin
# KEYCLOAK_PORT=8180
# KEYCLOAK_BIND=127.0.0.1
# Required with docker-compose.prod.yml:
# KEYCLOAK_HOSTNAME=https://id.example.org
# KEYCLOAK_DB_PASSWORD=
# Where users open the app (client redirect addresses); required with docker-compose.prod.yml.
# APP_PUBLIC_URL=https://mlw.example.org

# Login with Keycloak. Set by the compose override files; set it yourself only for another
# Keycloak. OIDC_ISSUER is the public URL of the realm, as seen by browsers.
# OIDC_ISSUER=http://localhost:8180/realms/mlw
# OIDC_CLIENT_ID=mlw-app
# OIDC_JWKS_URL=http://keycloak:8080/realms/mlw/protocol/openid-connect/certs
# Realm role users must have; empty allows every user of the realm.
# OIDC_REQUIRED_ROLE=mlw-user

# --- TLS / HTTPS (see docker-compose.tls.yml and scripts/gen-certs.sh) ---
# Password of the PKCS12 keystore that gen-certs.sh creates for Cassandra.
# CASSANDRA_KEYSTORE_PASSWORD=changeit
# Lowest TLS version the app accepts for HTTPS: 1.2 or 1.3.
# TLS_MIN_VERSION=1.2
# Name the Cassandra certificate is checked against (set when connecting by IP, or for a remote cluster).
# CASSANDRA_TLS_SERVER_NAME=cassandra
# Client certificate, for a cluster that requires mutual TLS.
# CASSANDRA_TLS_CERT_FILE=
# CASSANDRA_TLS_KEY_FILE=
