digraph G { graph [rankdir=LR, fontname="Helvetica", nodesep=0.45, ranksep=0.7, pad=0.2]; node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, margin="0.15,0.08"]; edge [fontname="Helvetica", fontsize=9, color="#555555", arrowsize=0.7];
 node [width=1.3]
 project [label="project", fillcolor="#EBE0F3", color="#6B3F8C"]
 production [label="production\n(row = sequence)", fillcolor="#DCE9F7", color="#2F5C8F"]
 sequence [label="sequence\n(row = scene)", fillcolor="#DCE9F7", color="#2F5C8F"]
 scene [label="scene\n(row = shot)", fillcolor="#DCE9F7", color="#2F5C8F"]
 shot [label="shot\n(row = shot)", fillcolor="#DCE9F7", color="#2F5C8F"]
 frame [label="frame\n(row = layer of a frame)", fillcolor="#DCE9F7", color="#2F5C8F"]
 project -> production [label="project_id\n1..*", dir=back, arrowtail=diamond, arrowhead=none]
 production -> sequence [label="sequence_id\n1..*", dir=back, arrowtail=diamond, arrowhead=none]
 sequence -> scene [label="scene_id\n1..*", dir=back, arrowtail=diamond, arrowhead=none]
 scene -> shot [label="shot_id\n1..*", dir=back, arrowtail=diamond, arrowhead=none]
 shot -> frame [label="shot_id\n1..*", dir=back, arrowtail=diamond, arrowhead=none]
}
