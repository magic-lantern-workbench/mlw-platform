digraph G { graph [rankdir=LR, fontname="Helvetica", nodesep=0.45, ranksep=0.7, pad=0.2]; node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, margin="0.15,0.08"]; edge [fontname="Helvetica", fontsize=9, color="#555555", arrowsize=0.7];
 project [label="project", fillcolor="#EBE0F3", color="#6B3F8C"]
 user [label="user", fillcolor="#EBE0F3", color="#6B3F8C"]
 user_by_email [label="user_by_email\n(lookup)", fillcolor="#EBE0F3", color="#6B3F8C", style="rounded,filled,dashed"]
 project_member [label="project_member", fillcolor="#EBE0F3", color="#6B3F8C"]
 project_by_user [label="project_by_user\n(lookup)", fillcolor="#EBE0F3", color="#6B3F8C", style="rounded,filled,dashed"]
 version_control [label="version_control", fillcolor="#E4E4E4", color="#555555"]
 revision [label="revision", fillcolor="#E4E4E4", color="#555555"]
 project -> user [label="owner_id"]
 project_member -> project [label="project_id"]
 project_member -> user [label="user_id"]
 project_by_user -> user [label="user_id"]
 project_by_user -> project [label="project_id"]
 user_by_email -> user [label="user_id"]
 project_member -> project_by_user [style=dashed, dir=both, label="kept in sync", constraint=false]
 version_control -> project [label="project_id"]
 version_control -> revision [label="1..*", dir=back, arrowtail=diamond, arrowhead=none]
 revision -> user [label="author"]
}
