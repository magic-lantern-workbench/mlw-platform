digraph G { graph [rankdir=LR, fontname="Helvetica", nodesep=0.45, ranksep=0.7, pad=0.2]; node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, margin="0.15,0.08"]; edge [fontname="Helvetica", fontsize=9, color="#555555", arrowsize=0.7];
 shot [label="shot", fillcolor="#DCE9F7", color="#2F5C8F"]
 frame [label="frame", fillcolor="#DCE9F7", color="#2F5C8F"]
 layer [label="layer", fillcolor="#DCE9F7", color="#2F5C8F"]
 asset [label="asset", fillcolor="#E3F1DF", color="#3D7A33"]
 audio_ref [label="audio_ref", fillcolor="#E3F1DF", color="#3D7A33"]
 dialog [label="dialog", fillcolor="#E3F1DF", color="#3D7A33"]
 note [label="note", fillcolor="#E3F1DF", color="#3D7A33"]
 track [label="track", fillcolor="#E3F1DF", color="#3D7A33"]
 exposure_sheet [label="exposure_sheet", fillcolor="#DCE9F7", color="#2F5C8F"]
 shot -> frame [label="1..*", dir=back, arrowtail=diamond, arrowhead=none]
 shot -> layer [label="1..*", dir=back, arrowtail=diamond, arrowhead=none]
 shot -> exposure_sheet [label="1 per shot", dir=back, arrowtail=diamond, arrowhead=none]
 shot -> audio_ref [label="1..*", dir=back, arrowtail=diamond, arrowhead=none]
 shot -> dialog [label="1..*", dir=back, arrowtail=diamond, arrowhead=none]
 shot -> note [label="1..*", dir=back, arrowtail=diamond, arrowhead=none]
 frame -> layer [label="layer_id"]
 frame -> audio_ref [label="audio_ref"]
 frame -> dialog [label="dialog_ref"]
 frame -> note [label="note_ref"]
 layer -> asset [label="asset_ref"]
 audio_ref -> track [label="track"]
}
